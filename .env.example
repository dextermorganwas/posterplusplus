# Required
TMDB_API_KEY=

# Strongly recommended for TVDB-first art
TVDB_API_KEY=
TVDB_PIN=

# Required for the PostersPlus-style award/festival/keyword sash family.
# Trending list pages do not need this key.
MDBLIST_API_KEY=

# Optional shared secret. Keep this set when exposing the service publicly.
ACCESS_KEY=

# Image sizes
TMDB_POSTER_SIZE=w780
TMDB_BACKDROP_SIZE=w1280
TMDB_LOGO_SIZE=w500

# Caching / refresh
ART_CACHE_TTL_SECONDS=2592000
SELECTION_CACHE_TTL_SECONDS=86400
METADATA_CACHE_TTL_SECONDS=604800
TOP_RATED_REFRESH_HOURS=24
TOP_RATED_MIN_VOTES=500
CACHE_DIR=/app/cache

# TVDB density thresholds
TVDB_MIN_ARTWORKS=10
TVDB_MIN_LOGOS=3

# Behaviour
TEXTLESS_BACKDROPS_ONLY=true
ENABLE_SASHES=true
TRENDING_FETCH_COUNT=40
TRENDING_BROAD_FETCH_COUNT=100
TRENDING_SOURCE_MOVIE=
TRENDING_SOURCE_TV=
UPSTREAM_CONCURRENCY=12
HTTP_TIMEOUT_SECONDS=20

# Sash geometry / colour tuning
SASH_BOTTOM_LINE_RATIO=0.012
SASH_TAB_HEIGHT_RATIO=0.070
SASH_TAB_RADIUS_RATIO=0.016
SASH_FONT_RATIO=0.040
SASH_SIDE_PAD_RATIO=0.025
SASH_DARK_THRESHOLD=0.17
SASH_FORCE_GRAY_ON_DARK=true

# Priority order. PostersPlus vocabulary + Top Rated.
SASH_PRIORITY=trending,wins,gg_wins,festival,pic_noms,gg_noms,metacritic,top_rated,premiere,just_added,new_season,season_finale,returning,studio,director,cast,cult,true_story,short_film,mini_series,binge_ready,streaming,physical,cinema,airing,cancelled,ended
