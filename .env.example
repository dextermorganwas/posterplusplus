# Server
PORT=8000
HOST=0.0.0.0
ACCESS_KEY=

# Provider API keys
TMDB_API_KEY=
TVDB_API_KEY=
TVDB_PIN=
MDBLIST_API_KEY=

# TMDB image sizes
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=w1280
TMDB_LOGO_SIZE=w500

# Caches
CACHE_DIR=/app/cache
ART_CACHE_TTL_SECONDS=2592000
SELECTION_CACHE_TTL_SECONDS=86400
METADATA_CACHE_TTL_SECONDS=604800
DISCOVERY_CACHE_TTL_SECONDS=21600

# TVDB quality gates
TVDB_MIN_ARTWORKS=10
TVDB_MIN_LOGOS=3

# Backdrops
TEXTLESS_BACKDROPS_ONLY=true

# IMDb Top Rated (daily dataset refresh)
TOP_RATED_THRESHOLD=8.5
TOP_RATED_MIN_VOTES=500
TOP_RATED_REFRESH_HOURS=24

# Resource limits
UPSTREAM_CONCURRENCY=12
IMAGE_PROCESSING_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=20

# PostersPlus-compatible trending sources
TRENDING_FETCH_COUNT=40
TRENDING_BROAD_FETCH_COUNT=100
TRENDING_SOURCE_MAX_ITEMS=500
TRENDING_SOURCE_RETRY_SECONDS=300
TRENDING_SOURCE_MOVIE=
TRENDING_SOURCE_TV=

# PostersPlus discovery polling
DIGITAL_RELEASE_MIN_AGE_DAYS=1
DIGITAL_RELEASE_MAX_AGE_DAYS=30
CINEMA_MAX_AGE_YEARS=3

# Sash rendering
ENABLE_SASHES=true
SASH_BOTTOM_LINE_RATIO=0.014
SASH_TAB_HEIGHT_RATIO=0.085
SASH_TAB_RADIUS_RATIO=0.018
SASH_FONT_RATIO=0.055
SASH_MIN_FONT_RATIO=0.038
SASH_SIDE_PAD_RATIO=0.030
SASH_MIN_TAB_WIDTH_RATIO=0.32
SASH_MAX_TAB_WIDTH_RATIO=0.70
SASH_TAB_WIDTH_RATIO=0.35
SASH_DARK_THRESHOLD=0.17
SASH_FORCE_GRAY_ON_DARK=true
SASH_BOTTOM_INSET_RATIO=0.012
SASH_TEXT_VERTICAL_OFFSET_RATIO=0.004

# Exact PostersPlus sash vocabulary remains available, plus the new Top Rated sash.
# The default enabled/priority order below matches the user's requested default order.
# Other PostersPlus sash slots can be enabled/reordered here at any time.
SASH_PRIORITY=trending,wins,gg_wins,festival,pic_noms,metacritic,gg_noms,top_rated,premiere,new_release,just_added,new_season,season_finale,studio,director,cast,cult,true_story,short_film,mini_series,binge_ready,returning,airing,cancelled,ended,cinema

# Optional host-side bind-mount location for persistent cache/state.
# Leave as ./cache for the simplest deployment.
ART_SELECTION_ALGORITHM_VERSION=4
CACHE_HOST_PATH=./cache
