# Server
PORT=8000
HOST=0.0.0.0
ACCESS_KEY=

# Provider API keys
TMDB_API_KEY=
TVDB_API_KEY=
TVDB_PIN=
MDBLIST_API_KEY=

# TMDB image sizes
TMDB_POSTER_SIZE=w780
TMDB_BACKDROP_SIZE=w1280
TMDB_LOGO_SIZE=w500

# Caches
CACHE_DIR=/app/cache
ART_CACHE_TTL_SECONDS=2592000
SELECTION_CACHE_TTL_SECONDS=86400
METADATA_CACHE_TTL_SECONDS=604800
DISCOVERY_CACHE_TTL_SECONDS=21600

# TVDB quality gates
TVDB_MIN_ARTWORKS=10
TVDB_MIN_LOGOS=3

# Backdrops
TEXTLESS_BACKDROPS_ONLY=true

# IMDb Top Rated (daily dataset refresh)
TOP_RATED_THRESHOLD=8.5
TOP_RATED_MIN_VOTES=500
TOP_RATED_REFRESH_HOURS=24

# Resource limits
UPSTREAM_CONCURRENCY=12
IMAGE_PROCESSING_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=20

# PostersPlus-compatible trending sources
TRENDING_FETCH_COUNT=40
TRENDING_BROAD_FETCH_COUNT=100
TRENDING_SOURCE_MAX_ITEMS=500
TRENDING_SOURCE_RETRY_SECONDS=300
TRENDING_SOURCE_MOVIE=
TRENDING_SOURCE_TV=

# PostersPlus discovery polling
DIGITAL_RELEASE_MIN_AGE_DAYS=1
DIGITAL_RELEASE_MAX_AGE_DAYS=30
CINEMA_MAX_AGE_YEARS=3

# Sash rendering
ENABLE_SASHES=true
SASH_BOTTOM_LINE_RATIO=0.012
SASH_TAB_HEIGHT_RATIO=0.070
SASH_TAB_RADIUS_RATIO=0.016
SASH_FONT_RATIO=0.040
SASH_SIDE_PAD_RATIO=0.025
SASH_DARK_THRESHOLD=0.17
SASH_FORCE_GRAY_ON_DARK=true

# Exact PostersPlus sash vocabulary + new Top Rated.
# Remove/reorder any entries to change priority.
SASH_PRIORITY=wins,gg_wins,festival,pic_noms,gg_noms,trending,trending_broad,metacritic,top_rated,premiere,new_release,just_added,new_season,season_finale,studio,director,cast,cult,foreign,true_story,short_film,mini_series,binge_ready,returning,airing,cancelled,ended,physical,streaming,cinema,production

# Optional host-side bind-mount location for persistent cache/state.
# Leave as ./cache for the simplest deployment.
CACHE_HOST_PATH=./cache
